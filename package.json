    "format": "prettier --write \"src/**/*.{ts,css}\" \"*.{ts,json,md,html}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
