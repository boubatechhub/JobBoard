{
  "name": "offres-alternance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interface de presentation des offres d'alternance",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
